# 复制为 .env（已在 .gitignore，不入仓）。密钥仅走环境变量，不写进 config.yaml。
# 变量名规则：ECHOTALK_ + 配置路径（点替换为下划线，大写）。

# MySQL
ECHOTALK_MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/echotalk?charset=utf8mb4&parseTime=True&loc=Local

# Redis
ECHOTALK_REDIS_PASSWORD=

# JWT 签名密钥
ECHOTALK_JWT_SECRET=change-me

# 科大讯飞 ISE
ECHOTALK_IFLYTEK_APP_ID=
ECHOTALK_IFLYTEK_API_KEY=
ECHOTALK_IFLYTEK_API_SECRET=

# 腾讯云 COS
ECHOTALK_COS_SECRET_ID=
ECHOTALK_COS_SECRET_KEY=
